<IfModule mod_rewrite.c>
    Options +FollowSymLinks -MultiViews
    RewriteEngine On
    RewriteBase /

    # Issue #4: listados estáticos duplicados → home/productos PHP (misma grilla que /)
    RewriteRule ^herrajes/index\.html$ / [R=301,L]
    RewriteRule ^herrajes/productos\.html$ /productos [R=301,L]
    RewriteRule ^herrajes/(bisagras|cerraduras|oscilo-batientes|varios|felpas|ruedas)\.html$ /productos/$1 [R=301,L]

    # Si es archivo real, servir directo
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # Si es directorio real, servir directo
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Rutas con 2 parametros: /productos/felpas/detalle -> productos.php?p1=felpas&p2=detalle
    RewriteRule ^([^/]+)/([^/]+)/([^/]+)/?$ $1.php?p1=$2&p2=$3 [L,QSA]

    # Rutas con 1 parametro: /productos/felpas -> productos.php?p1=felpas
    RewriteRule ^([^/]+)/([^/]+)/?$ $1.php?p1=$2 [L,QSA]

    # Paginas simples sin .php: /contacto -> contacto.php
    RewriteRule ^([^/]+)/?$ $1.php [L,QSA]
</IfModule>